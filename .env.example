# Copy to .env for local runs (docker compose reads it). Every variable the
# program reads is listed here; see docs/configuration.md for details.
# The defaults below work out of the box: `cp .env.example .env` then
# `docker compose up` runs the stack in dry-run mode against the example
# configuration — no bot token, registry account or cloud credentials.

# ---------------------------------------------------------------------------
# Spec source — exactly one of these three must be set; first present wins.
# Missing all three is a startup error that names all of them.
#
#   SPEC_JSON  the full spec as an inline JSON string. This is how cloud
#              deployments inject the config from a secret store. Container
#              platforms cap secret/env sizes (Azure Container Apps accepts
#              the ~10 KB reference spec; expect low-hundreds-of-KB ceilings
#              elsewhere) — for very large specs use SPEC_URL instead.
#   SPEC_URL   an https:// URL fetched once at startup. A failed fetch or an
#              unparsable body is fatal; the loader never falls back to a
#              lower-precedence source.
#   SPEC_PATH  a file path — the local-development route. The compose files
#              mount your spec at /app/spec.json (see SPEC_FILE below).
#
# SPEC_JSON=
# SPEC_URL=
SPEC_PATH=/app/spec.json

# Directory for resolving a source's relative schema_file (XSD) paths when
# the spec arrives via SPEC_JSON/SPEC_URL and has no directory of its own.
# Optional; defaults to the working directory (/app in the image, which is
# where schemas/ lives).
# SPEC_BASE_DIR=

# Compose-only: host path mounted to /app/spec.json. Defaults to the tracked
# example. After creating your own config (cp spec.example.json spec.json),
# point it there:
# SPEC_FILE=./spec.json

# Compose-only: image reference for the app services. Default builds locally
# from this checkout.
# IMAGE=news-tg-bot:local

# ---------------------------------------------------------------------------
# Required per command (a missing variable fails startup and names every
# missing variable at once):
#   run, stats, export : DATABASE_URL
#   serve              : DATABASE_URL, TELEGRAM_WEBHOOK_SECRET
#   register-webhook   : TELEGRAM_BOT_TOKEN, WEBHOOK_URL, TELEGRAM_WEBHOOK_SECRET
#   validate, fetch    : only a spec source (or --spec PATH)

# Postgres connection string. The compose default below points at the
# bundled db service.
DATABASE_URL=postgresql://newsbot:newsbot@db:5432/newsbot

# Compose-only: password for the bundled db service (defaults to "newsbot"
# for local development).
# POSTGRES_PASSWORD=newsbot

# Bot token from @BotFather. Empty disables all Telegram sending (errors are
# still recorded in the database). Required by `register-webhook`.
TELEGRAM_BOT_TOKEN=

# "true" (default) records channel posts as skipped instead of sending them.
# Truthy values: 1, true, yes. Note: operator alerts and ops-chat replies are
# NOT suppressed by dry run — only channel posting is.
DRY_RUN=true

# Python log level (debug, info, warning, error). Unknown values fall back
# to info.
LOG_LEVEL=info

# Lead translation: "none" (default) or "deepl". With "deepl" set the API
# key below; without it, translation silently degrades to a no-op.
TRANSLATE_PROVIDER=none
TRANSLATE_API_KEY=

# Deadman switch: URL that gets a GET after every successful fetch pass,
# e.g. a healthchecks.io check URL. The monitor alarms when pings stop.
# Empty disables.
HEALTHCHECK_URL=

# Webhook app: the secret compared against X-Telegram-Bot-Api-Secret-Token
# on every request — empty rejects all webhook calls. Generate with e.g.
# `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS endpoint passed to Telegram by `cli register-webhook`,
# e.g. https://<your-app-fqdn>/telegram/webhook
WEBHOOK_URL=

# Port `cli serve` listens on.
PORT=8000

# Test-only: DSN the pytest suite uses for Postgres-backed tests. The
# default matches the compose db's host port mapping (5433).
# TEST_DATABASE_URL=postgresql://newsbot:newsbot@localhost:5433/newsbot_test
