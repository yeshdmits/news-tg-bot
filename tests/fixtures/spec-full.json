      "pin_critical": true,
      "quiet_hours": {
        "from": "23:00",
        "to": "07:00",
        "timezone": "Europe/Zurich",
        "suppress_below": "critical"
      }
    },

    "classification": {
      "SchemaValidationFailed": { "severity": "critical", "escalate_after": 1 },
      "FetchHttpError5xx": { "severity": "warning", "escalate_after": 5, "escalates_to": "error" },
      "TranslationProviderError": { "severity": "warning", "escalate_after": 3, "escalates_to": "error" }
    },

    "source_overrides": {
      "snb-press": { "FetchHttpError4xx": { "severity": "info" } }
    },

    "retention": { "occurrences_days": 30, "events_days": 365 }
  },

  "defaults": {
    "fetch_limit": 10,
    "fetch_interval_min": 15,
    "lead_max_length": 300,
